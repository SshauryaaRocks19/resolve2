# .env.example — Copy this to `.env` and fill in your values
# ===========================================================

# LLM Provider: "google", "openai", or "huggingface"
LLM_PROVIDER=google

# LLM Model name
LLM_MODEL=gemini-2.0-flash

# Your API key (NEVER commit your real key — add .env to .gitignore)
LLM_API_KEY=your_api_key_here
